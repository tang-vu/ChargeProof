# Public network configuration
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CREDITCOIN_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network
ATTESTCOIN_SOURCE_CHAIN_KEY=1
GATE2_TIMEOUT_MINUTES=60

# Public deployment metadata (leave blank until deployed)
NEXT_PUBLIC_SEPOLIA_REGISTRY_ADDRESS=
NEXT_PUBLIC_CREDITCOIN_ESCROW_ADDRESS=
NEXT_PUBLIC_CREDITCOIN_VERIFIER_ADDRESS=
NEXT_PUBLIC_CREDITCOIN_STATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_CREDITCOIN_MOCK_USDC_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Burner deployment wallets only. Never use a wallet with real funds.
# Never expose either variable to the browser or paste its value into chat.
SEPOLIA_DEPLOYER_PRIVATE_KEY=
CREDITCOIN_DEPLOYER_PRIVATE_KEY=
CREDITCOIN_SETTLER_PRIVATE_KEY=

# Ephemeral server-only key for demo receipt signing. Prefer generating a new
# key per demo and never persist it in frontend code, browser bundles, logs, or Git.
DEVICE_SIMULATOR_PRIVATE_KEY=
DEVICE_SIGNER_ADDRESS=
STATION_PAYOUT_ADDRESS=
SEPOLIA_REGISTRY_ADDRESS=
CREDITCOIN_VERIFIER_ADDRESS=

# Optional one-off demo video narration. Create a dedicated key and keep it local.
# Token Plan users must override the base URL with the URL shown in their console.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_AUTH_HEADER=authorization
MIMO_TTS_VOICE=Milo
MIMO_ASR_MAX_WER=0.18
