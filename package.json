{
  "name": "chargeproof",
  "version": "0.1.0",
  "private": true,
  "description": "Trustless cross-chain EV charging settlement powered by Attestcoin",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "compile": "pnpm --filter \"@chargeproof/contracts-*\" compile",
    "dev": "pnpm --filter @chargeproof/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "integration:local": "pnpm --filter @chargeproof/contracts-sepolia exec hardhat test --grep \"finalizes a deterministic\" && pnpm --filter @chargeproof/contracts-creditcoin exec hardhat test --grep \"escrows, verifies, settles\" && pnpm --filter @chargeproof/attestation-worker test",
    "lint": "pnpm lint:root && pnpm prepare:workspace && pnpm -r --if-present lint",
    "lint:root": "eslint eslint.config.mjs scripts/*.mjs",
    "prepare:workspace": "pnpm --filter @chargeproof/shared build && pnpm --filter @chargeproof/attestation-worker build",
    "test": "pnpm prepare:workspace && pnpm -r --if-present test",
    "test:contracts": "pnpm --filter \"@chargeproof/contracts-*\" test",
    "typecheck": "pnpm prepare:workspace && pnpm -r --if-present typecheck",
    "proof:inspect": "pnpm --filter @chargeproof/attestation-worker proof:inspect",
    "proof:resume": "pnpm --filter @chargeproof/attestation-worker proof:resume",
    "wallets:create": "node scripts/create-testnet-burners.mjs",
    "wallets:status": "node scripts/check-testnet-readiness.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm compile && pnpm test && pnpm integration:local && pnpm build && pnpm secret:scan"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
